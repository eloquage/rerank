{
    "name": "eloquage/rerank",
    "description": "Cross-encoder and feature-based reranking helpers for PHP search pipelines (lexical + vector candidate sets).",
    "keywords": [
        "Eloquage",
        "rerank"
    ],
    "homepage": "https://github.com/eloquage/rerank",
    "license": "MIT",
    "authors": [
        {
            "name": "Miguel Enes",
            "email": "carlos.miguel.enes@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Eloquage\\Rerank\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eloquage\\Rerank\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
